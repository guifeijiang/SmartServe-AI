<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowflow.mapper.MessageOutboxMapper">

    <resultMap id="MessageOutboxResultMap" type="com.knowflow.entity.MessageOutbox">
        <id property="id" column="id"/>
        <result property="eventId" column="event_id"/>
        <result property="topic" column="topic"/>
        <result property="tag" column="tag"/>
        <result property="payload" column="payload"/>
        <result property="status" column="status"/>
        <result property="retryCount" column="retry_count"/>
        <result property="lastError" column="last_error"/>
        <result property="nextRetryAt" column="next_retry_at"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="sentAt" column="sent_at"/>
    </resultMap>

    <sql id="OutboxColumns">
        id, event_id, topic, tag, payload, status, retry_count, last_error,
        next_retry_at, created_at, updated_at, sent_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO message_outbox (event_id, topic, tag, payload, status, retry_count)
        VALUES (#{eventId}, #{topic}, #{tag}, #{payload}, #{status}, #{retryCount})
    </insert>

    <select id="findDuePending" resultMap="MessageOutboxResultMap">
        SELECT <include refid="OutboxColumns"/>
        FROM message_outbox
        WHERE status = 'PENDING'
          AND (next_retry_at IS NULL OR next_retry_at &lt;= CURRENT_TIMESTAMP)
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <update id="markSent">
        UPDATE message_outbox
        SET status = 'SENT',
            last_error = NULL,
            sent_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
          AND status = 'PENDING'
    </update>

    <update id="markRetry">
        UPDATE message_outbox
        SET status = #{status},
            retry_count = #{retryCount},
            last_error = #{lastError},
            next_retry_at = #{nextRetryAt}
        WHERE id = #{id}
          AND status = 'PENDING'
    </update>

    <select id="findById" resultMap="MessageOutboxResultMap">
        SELECT <include refid="OutboxColumns"/>
        FROM message_outbox
        WHERE id = #{id}
    </select>

    <select id="findByEventId" resultMap="MessageOutboxResultMap">
        SELECT <include refid="OutboxColumns"/>
        FROM message_outbox
        WHERE event_id = #{eventId}
    </select>
</mapper>
