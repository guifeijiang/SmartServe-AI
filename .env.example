# SmartServe AI environment template.
# These are OS environment variables for the backend, not a file Spring Boot loads automatically.
# Never commit real values. Copy the names below into your shell or Windows user environment.
KNOWFLOW_DB_HOST=127.0.0.1
KNOWFLOW_DB_PORT=3306
KNOWFLOW_DB_USERNAME=
KNOWFLOW_DB_PASSWORD=
KNOWFLOW_JWT_SECRET=

# Local Ollama chat model (default, no paid API key required)
KNOWFLOW_AI_CHAT_PROVIDER=ollama
KNOWFLOW_OLLAMA_CHAT_MODEL=deepseek-r1:1.5b

# Optional remote DeepSeek provider. Only needed when KNOWFLOW_AI_CHAT_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
KNOWFLOW_CHAT_MODEL=deepseek-chat

# Local Ollama embedding model. Pull with: ollama pull bge-m3
OLLAMA_BASE_URL=http://127.0.0.1:11434
KNOWFLOW_EMBEDDING_MODEL=bge-m3
KNOWFLOW_EMBEDDING_DIMENSIONS=1024

# Spring AI Alibaba 内置 text-embedding-v3（推荐，简历技术栈）：auto = 有 Key 用百炼，没有 Key 回退本地 bge-m3
# 注意：该接口按 token 计费，未确认免费额度前不要批量处理大量文档。
KNOWFLOW_AI_EMBEDDING_PROVIDER=auto
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
KNOWFLOW_DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
KNOWFLOW_DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# RAG: Redis Stack 向量索引（用本地 Docker 起 redis-stack-server 时配置）
KNOWFLOW_RAG_VECTOR_STORE=auto
KNOWFLOW_REDIS_HOST=127.0.0.1
KNOWFLOW_REDIS_PORT=6379
KNOWFLOW_REDIS_PASSWORD=
KNOWFLOW_REDIS_DATABASE=0
KNOWFLOW_RAG_RECALL_TOP_K=5
KNOWFLOW_RAG_RERANK_TOP_N=3
KNOWFLOW_RAG_SIMILARITY_THRESHOLD=0.45
KNOWFLOW_RAG_RERANK_STRATEGY=auto

# Optional RocketMQ (disabled by default for local development)
KNOWFLOW_ROCKETMQ_NAME_SERVER=127.0.0.1:9876
